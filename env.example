# Copy this file to `.env` for local production-like runs. Never commit `.env`.
#
# On Railway, set these as project variables instead (Settings > Variables) —
# Railway injects them into the running container; this file is just documentation
# plus a local fallback (loaded automatically by the dotenv-rails gem).

# --- Rails ---
RAILS_ENV=production
# Contents of config/master.key. Required to decrypt config/credentials.yml.enc.
RAILS_MASTER_KEY=
RAILS_LOG_LEVEL=info
# Custom domain the app is served from, e.g. garage.example.com.
# Optional — if unset, mailer links fall back to Railway's own generated
# domain (RAILWAY_PUBLIC_DOMAIN, set automatically by Railway) or "example.com".
APP_HOST=

# --- Database (config/database.yml) ---
# On Railway, add a Postgres plugin and reference its variable:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally, point at your own Postgres instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/garage_manager_app_production
RAILS_MAX_THREADS=5

# --- Puma / Solid Queue (config/puma.rb) ---
WEB_CONCURRENCY=1
JOB_CONCURRENCY=1
SOLID_QUEUE_IN_PUMA=true
