<h1 class="text-2xl font-bold mb-4"><%= t("repairs.show_heading", date: @repair.date) %></h1>

<p><strong><%= t("repairs.fields.car") %>:</strong> <%= link_to @repair.car.plate, car_path(@repair.car) %></p>
<p><strong><%= t("repairs.fields.km") %>:</strong> <%= @repair.km %></p>
<p><strong><%= t("repairs.fields.notes") %>:</strong> <%= @repair.notes %></p>

<h2 class="text-xl font-semibold mt-6 mb-2"><%= t("repairs.fields.parts") %></h2>
<table class="w-full border-collapse">
  <thead>
    <tr class="text-left border-b">
      <th class="py-2"><%= t("parts.fields.name") %></th>
      <th class="py-2"><%= t("parts.fields.quantity") %></th>
      <th class="py-2"><%= t("parts.fields.price") %></th>
    </tr>
  </thead>
  <tbody>
    <% @repair.parts.each do |part| %>
      <tr class="border-b">
        <td class="py-2"><%= part.name %></td>
        <td class="py-2"><%= part.quantity %></td>
        <td class="py-2"><%= "#{part.price}€" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p class="mt-4 font-bold"><%= t("repairs.fields.total") %>: <%= "#{@repair.total}€" %></p>

<%= link_to t("common.edit"), edit_repair_path(@repair), class: "inline-block mt-4 underline" %>
<%= link_to t("common.back"), repairs_path, class: "inline-block mt-4 ml-4 underline" %>
