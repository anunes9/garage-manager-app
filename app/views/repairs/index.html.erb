<%= render "shared/page_head",
      title: t("repairs.title"),
      eyebrow: t("repairs.count", count: @repairs.size),
      cta_text: t("repairs.new"),
      cta_path: new_repair_path %>

<div class="row-card-list md:hidden">
  <% @repairs.each do |repair| %>
    <div class="row-card">
      <div class="row-card__body">
        <div class="flex justify-between">
          <%= plate_badge(repair.car.plate) %>
          <span class="row-card__title cell-mono"><%= repair.date %></span>
        </div>

        <span class="row-card__meta cell-mono"><%= repair.car.client.name %></span>
        <span class="row-card__meta cell-mono">Total: <%= price_with_currency(repair.total) %></span>
      </div>
      <div class="row-card__actions">
        <%= link_to t("common.view"), repair_path(repair), class: "btn-secondary w-full" %>
      </div>
    </div>
  <% end %>
</div>

<div class="card overflow-x-auto hidden md:block">
  <table class="data-table">
    <thead>
      <tr>
        <th><%= t("repairs.fields.car") %></th>
        <th><%= t("repairs.fields.date") %></th>
        <th><%= t("repairs.fields.total") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @repairs.each do |repair| %>
        <tr class="cursor-pointer" data-controller="clickable-row" data-clickable-row-url-value="<%= repair_path(repair) %>" data-action="click->clickable-row#visit">
          <td><%= link_to car_path(repair.car) do %><%= plate_badge(repair.car.plate) %><% end %></td>
          <td class="cell-mono"><%= link_to repair.date, repair_path(repair), class: "hover:text-[var(--color-accent)]" %></td>
          <td class="cell-mono"><%= price_with_currency(repair.total) %></td>
          <td class="cell-actions">
            <%= link_to t("common.view"), repair_path(repair), class: "btn-text" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
