<%= render "shared/page_head", title: "#{@car.brand} #{@car.model}", eyebrow: t("cars.title") %>

<div class="card p-6 max-w-2xl">
  <div class="mb-2"><%= plate_badge(@car.plate) %></div>

  <dl>
    <div class="detail-row">
      <dt><%= t("cars.fields.client") %></dt>
      <dd><%= link_to @car.client.name, client_path(@car.client), class: "hover:text-[var(--color-accent)]" %></dd>
    </div>
  </dl>

  <h2 class="title-display text-2xl mt-8 mb-3"><%= t("repairs.title") %></h2>
  <ul class="space-y-2">
    <% @car.repairs.order(date: :desc).each do |repair| %>
      <li>
        <%= link_to repair_path(repair), class: "hover:text-[var(--color-accent)]" do %>
          <span class="cell-mono"><%= repair.date %></span> — <span class="cell-mono"><%= "#{repair.total}€" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="mt-8 flex gap-6">
    <%= link_to t("common.edit"), edit_car_path(@car), class: "btn-text" %>
    <%= link_to t("common.back"), cars_path, class: "btn-text" %>
  </div>
</div>
