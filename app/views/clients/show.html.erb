<%= render "shared/page_head", title: @client.name, eyebrow: t("clients.title") %>

<div class="card p-6 max-w-2xl">
  <dl>
    <div class="detail-row">
      <dt><%= t("clients.fields.phone") %></dt>
      <dd class="cell-mono"><%= @client.phone %></dd>
    </div>
  </dl>

  <h2 class="title-display text-2xl mt-8 mb-3"><%= t("cars.title") %></h2>
  <ul class="space-y-2">
    <% @client.cars.each do |car| %>
      <li>
        <%= link_to car_path(car), class: "inline-flex items-center gap-3 hover:text-[var(--color-accent)]" do %>
          <%= plate_badge(car.plate) %>
          <span><%= "#{car.brand} #{car.model}" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="mt-8 flex gap-6">
    <%= link_to t("common.edit"), edit_client_path(@client), class: "btn-text" %>
    <%= link_to t("common.back"), clients_path, class: "btn-text" %>
  </div>
</div>
