<%= form_with model: client, class: "card p-6 max-w-xl space-y-5" do |f| %>
  <% if client.errors.any? %>
    <div class="form-error-box">
      <ul>
        <% client.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, t("clients.fields.name"), class: "field-label" %>
    <%= f.text_field :name, class: "field-input" %>
  </div>

  <div>
    <%= f.label :phone, t("clients.fields.phone"), class: "field-label" %>
    <%= f.text_field :phone, class: "field-input" %>
  </div>

  <%= f.submit(client.persisted? ? t("clients.update_button") : t("clients.create_button"), class: "btn-primary cursor-pointer w-full sm:w-auto") %>
<% end %>
